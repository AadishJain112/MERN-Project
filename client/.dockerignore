# ============================================
# Frontend .dockerignore
# ============================================
# Files/folders listed here won't be copied into Docker image

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output (will be rebuilt in container)
dist/
build/

# Environment files
.env
.env.local
.env.*.local

# Git files
.git/
.gitignore
.gitattributes

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Test files
coverage/
.nyc_output/

# Documentation
README.md
*.md

# Docker files
Dockerfile
.dockerignore
docker-compose.yml

# Source maps (optional - remove if you want them)
*.map

